# SmartFlow 环境变量模板
# 复制此文件为 .env 并填入你的配置（docker-compose 会自动读取）
# cp .env.example .env

# LLM API 配置（必填）
LLM_API_KEY=your-api-key-here

# API 地址（按你使用的服务填写）
# DeepSeek:  https://api.deepseek.com/v1
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# Infini-AI: https://cloud.infini-ai.com/maas/v1
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
LLM_MODEL=deepseek-chat

# 接口鉴权 Token（可选）：设置后所有 /api/* 接口需携带
# Authorization: Bearer <token>。留空则不鉴权。
# 生成方式：openssl rand -hex 32
SMARTFLOW_API_TOKEN=

# 开发模式（可选）：设为 true 时 uvicorn 开启热重载
# APP_RELOAD=true
