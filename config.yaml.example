# SmartFlow LLM 配置模板
# 使用方法：
#   1. 复制为 config.yaml 并填入你的 API Key：
#      cp config.yaml.example config.yaml
#   2. 或者使用环境变量（优先级更高，推荐，避免 Key 落盘）：
#      LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
#
# 注意：config.yaml 已被 .gitignore 忽略，请勿提交真实 Key

llm:
  # OpenAI 兼容的 API Key（也可用环境变量 LLM_API_KEY）
  api_key: "your-api-key-here"

  # 模型名称，例如：
  # deepseek-chat / qwen-plus / gpt-4o-mini / kimi-k2.6
  model: "deepseek-chat"

  # OpenAI 兼容接口地址，例如：
  # DeepSeek:  https://api.deepseek.com/v1
  # 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
  # Infini-AI: https://cloud.infini-ai.com/maas/v1
  # OpenAI:    https://api.openai.com/v1
  base_url: "https://api.deepseek.com/v1"

  # 成本估算价格（可选）：每千 token 元，用于 /api/stats 的成本统计
  # 按你的模型实际价格填写；不配置则统计里 cost 为 null
  pricing:
    prompt: 0.001      # 每千输入 token 价格（元）
    completion: 0.002  # 每千输出 token 价格（元）

server:
  # 接口鉴权 Token（可选）：设置后所有 /api/* 接口需携带
  # Authorization: Bearer <token>，防止他人白嫖 API Key 或执行命令。
  # 生产环境推荐用环境变量 SMARTFLOW_API_TOKEN（不落盘）。
  # 留空 = 不鉴权（本地演示模式）。
  api_token: ""

tools:
  # web_search（Tavily）API Key。也可用环境变量 WEB_SEARCH_API_KEY（优先，推荐）。
  # 未配置时工具仍会出现在工具列表，但执行时返回配置提示。
  web_search:
    api_key: ""
  # code_exec：Docker 隔离沙箱执行 Python 代码（--network=none + 资源限制 + 只挂 outputs）。
  # 本机未安装 Docker 时工具返回「需要 Docker 环境」提示；enabled=false 直接禁用。
  code_exec:
    enabled: true
    docker_image: "python:3.11-slim"
