# SmartFlow LLM 配置模板
# 使用方法：
#   1. 复制为 config.yaml 并填入你的 API Key：
#      cp config.yaml.example config.yaml
#   2. 或者使用环境变量（优先级更高，推荐，避免 Key 落盘）：
#      LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
#
# 注意：config.yaml 已被 .gitignore 忽略，请勿提交真实 Key

llm:
  # OpenAI 兼容的 API Key（也可用环境变量 LLM_API_KEY）
  api_key: "your-api-key-here"

  # 模型名称，例如：
  # deepseek-chat / qwen-plus / gpt-4o-mini / kimi-k2.6
  model: "deepseek-chat"

  # OpenAI 兼容接口地址，例如：
  # DeepSeek:  https://api.deepseek.com/v1
  # 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
  # Infini-AI: https://cloud.infini-ai.com/maas/v1
  # OpenAI:    https://api.openai.com/v1
  base_url: "https://api.deepseek.com/v1"

server:
  # 接口鉴权 Token（可选）：设置后所有 /api/* 接口需携带
  # Authorization: Bearer <token>，防止他人白嫖 API Key 或执行命令。
  # 生产环境推荐用环境变量 SMARTFLOW_API_TOKEN（不落盘）。
  # 留空 = 不鉴权（本地演示模式）。
  api_token: ""
